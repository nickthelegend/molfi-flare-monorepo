# Molfi backend — Flare Coston2
MONGODB_URI=mongodb://127.0.0.1:27017
PORT=4000

# Chain (defaults are read from molfi-contracts/deployments/coston2.json)
MOLFI_RPC=https://coston2-api.flare.network/ext/C/rpc
MOLFI_CHAIN_ID=114

# Contract addresses — override only if not using the deployments file
# MOLFI_MARKET=
# MOLFI_ESCROW=
# MOLFI_CBET=
# MOLFI_VERIFIER=
# MOLFI_ORACLE=
# MOLFI_FXRP=

# FTSOv2 feed ids (bytes21) — defaults are the canonical crypto feeds
# FEED_XRP=0x015852502f55534400000000000000000000000000
# FEED_FLR=0x01464c522f55534400000000000000000000000000
# FEED_BTC=0x014254432f55534400000000000000000000000000
# FEED_ETH=0x014554482f55534400000000000000000000000000

# ZK circuit artifacts
MOLFI_CONF_CIRCUIT=../molfi-circuits/build/confidential_bet

# IPFS chat (optional)
# PINATA_JWT=
# PINATA_GATEWAY=
