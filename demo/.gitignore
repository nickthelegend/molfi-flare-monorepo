# Generated by the recording pipeline — all reproducible from the scripts here.
#
#   node demo/tts.mjs      -> audio/, durations.json
#   node demo/cards.mjs    -> work/intro.mp4, work/outro.mp4
#   node demo/record.mjs   -> raw/ (frames, take.mp4, beats.log, sync.json)
#   node demo/cut.mjs      -> out/molfi-demo.mp4 + .srt
#
# raw/ alone runs to hundreds of megabytes of JPEG frames.
raw/
work/
out/
audio/
